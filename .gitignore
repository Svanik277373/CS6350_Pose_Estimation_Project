# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/
.ipynb_checkpoints/

# Datasets (5 GB; re-created by scripts/download_*.py)
data/

# Network weights (MASt3R 2.75 GB, torch hub caches; downloaded on first use)
models/*
# keep: small classifiers (scripts/confidence.py) needed by the "confident" preset
!models/confidence/

# Third-party code cloned separately (MASt3R: git clone --recursive https://github.com/naver/mast3r external/mast3r)
external/

# Run logs and unfinished evaluation runs
logs/
results/**/partial.csv
results/_*/

# Secrets (MVImgNet password is passed as an environment variable, never stored)
.env

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Partial downloads
*.part

# CLIP weights pulled in by YOLO-World (338 MB; downloaded on first use)
weights/

# Reference report from another group (not ours to publish)
CS6350.pdf

# LaTeX build files
report/*.aux
report/*.log
report/*.out
report/*.toc

# Course template (provided, not ours) and downloaded reference papers (copyrighted)
TPA_Report_Format_Latex/
report/references/

# LaTeX / Beamer build files in report subfolders
report/**/*.aux
report/**/*.log
report/**/*.out
report/**/*.toc
report/**/*.nav
report/**/*.snm
report/**/*.synctex.gz

# Full-size PNG copies of figures the report uses as JPEG
report/final/figures/case_*.png
report/final/figures/methods.png
